{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Keep XP on death, with an optional level penalty. Supports permission mods.",
  "authors": [
    "FNewell"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/keep-xp-on-death-new",
    "sources": "https://github.com/FNewel/keepxp"
  },
  "license": "CC0-1.0",
  "icon": "assets/keep-xp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.fnewel.KeepXP"
    ]
  },
  "mixins": [
    "keep-xp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-permission-api-v1": "*"
  }
